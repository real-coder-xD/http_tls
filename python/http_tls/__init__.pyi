from typing import Any, Callable, Dict, Iterator, List, Optional, Tuple, Union
from http_tls.structures import CaseInsensitiveDict

__version__: str

def supported_presets() -> List[str]: ...

class Cookies(dict):
    def __init__(self, initial: Optional[Dict[str, str]] = None, on_clear: Optional[Callable[[], None]] = None) -> None: ...
    def clear(self) -> None: ...
    def set(self, name: str, value: str, domain: Optional[str] = None, path: Optional[str] = None) -> None: ...
    def get(self, name: str, default: Any = None) -> Any: ...
    def delete(self, name: str) -> None: ...

class Response:
    status_code: int
    headers: CaseInsensitiveDict
    url: str
    content: bytes
    text: str
    encoding: Optional[str]
    elapsed: float
    cookies: Cookies
    history: List["Response"]

    @property
    def ok(self) -> bool: ...
    @property
    def is_success(self) -> bool: ...
    @property
    def is_informational(self) -> bool: ...
    @property
    def is_redirect(self) -> bool: ...
    @property
    def is_client_error(self) -> bool: ...
    @property
    def is_server_error(self) -> bool: ...
    @property
    def is_error(self) -> bool: ...
    @property
    def reason(self) -> str: ...
    @property
    def challenge(self) -> Optional[str]: ...

    def read(self) -> bytes: ...
    async def aread(self) -> bytes: ...
    def json(self, **kwargs: Any) -> Any: ...
    def raise_for_status(self) -> None: ...
    def iter_content(self, chunk_size: Optional[int] = 1, decode_unicode: bool = False) -> Iterator[Any]: ...
    def iter_lines(self, chunk_size: int = 512, decode_unicode: bool = False, delimiter: Optional[Any] = None) -> Iterator[Any]: ...
    def close(self) -> None: ...
    def __enter__(self) -> "Response": ...
    def __exit__(self, *exc: Any) -> None: ...

class Session:
    impersonate: str
    headers: CaseInsensitiveDict
    cookies: Cookies
    proxies: Dict[str, str]
    mode: str

    def __init__(
        self,
        impersonate: str = "chrome_152",
        timeout: float = 30.0,
        verify: Union[bool, str] = True,
        verify_ssl: bool = True,
        proxies: Optional[Dict[str, str]] = None,
        proxy: Optional[str] = None,
        allow_redirects: bool = True,
        follow_redirects: bool = True,
        max_redirects: int = 10,
        headers: Optional[Dict[str, str]] = None,
        cookies: Optional[Dict[str, str]] = None,
        auth: Optional[Tuple[str, str]] = None,
        cert: Union[str, Tuple[str, str], None] = None,
        engine: str = "auto",
        **kwargs: Any,
    ) -> None: ...
    def clear_cookies(self) -> None: ...
    def request(
        self,
        method: str,
        url: str,
        params: Optional[Dict[str, Any]] = None,
        headers: Optional[Dict[str, str]] = None,
        cookies: Optional[Dict[str, str]] = None,
        data: Optional[Union[bytes, str, Dict[str, Any]]] = None,
        json: Optional[Any] = None,
        timeout: Optional[float] = None,
        verify: Optional[Union[bool, str]] = None,
        proxies: Optional[Dict[str, str]] = None,
        proxy: Optional[str] = None,
        allow_redirects: Optional[bool] = None,
        auth: Optional[Tuple[str, str]] = None,
        stream: bool = False,
        **kwargs: Any,
    ) -> Response: ...
    def get(self, url: str, **kwargs: Any) -> Response: ...
    def post(self, url: str, **kwargs: Any) -> Response: ...
    def put(self, url: str, **kwargs: Any) -> Response: ...
    def delete(self, url: str, **kwargs: Any) -> Response: ...
    def patch(self, url: str, **kwargs: Any) -> Response: ...
    def head(self, url: str, **kwargs: Any) -> Response: ...
    def options(self, url: str, **kwargs: Any) -> Response: ...
    def close(self) -> None: ...
    def __enter__(self) -> "Session": ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

class AsyncSession:
    headers: CaseInsensitiveDict
    cookies: Cookies

    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    async def request(self, method: str, url: str, **kwargs: Any) -> Response: ...
    async def get(self, url: str, **kwargs: Any) -> Response: ...
    async def post(self, url: str, **kwargs: Any) -> Response: ...
    async def put(self, url: str, **kwargs: Any) -> Response: ...
    async def delete(self, url: str, **kwargs: Any) -> Response: ...
    async def patch(self, url: str, **kwargs: Any) -> Response: ...
    async def head(self, url: str, **kwargs: Any) -> Response: ...
    async def options(self, url: str, **kwargs: Any) -> Response: ...
    async def close(self) -> None: ...
    async def __aenter__(self) -> "AsyncSession": ...
    async def __aexit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

# httpx-compatible aliases
Client = Session
AsyncClient = AsyncSession

def request(method: str, url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def get(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def post(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def put(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def delete(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def patch(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def head(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
def options(url: str, impersonate: str = "chrome_152", **kwargs: Any) -> Response: ...
